---
# Kokeb Labs org-wide clang-tidy configuration (clang-tidy 20).
# Source of truth: https://github.com/kokeb-labs/.github/tree/main/standards/config
# The naming rules are the ones in standards/naming-and-style.md; change both together.
Checks: >-
  -*,
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-branch-clone,
  -bugprone-crtp-constructor-accessibility,
  -bugprone-easily-swappable-parameters,
  -bugprone-suspicious-include,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-special-member-functions,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-redundant-inline-specifier,
  -readability-uppercase-literal-suffix

# Why each check above is off:
#   bugprone-branch-clone            error-code mapping switches repeat branches on purpose
#   bugprone-crtp-constructor-..    port bases keep a protected constructor so any port can derive
#   bugprone-easily-swappable-...    register and bus APIs take several integers by nature
#   bugprone-suspicious-include      drivers include their src/<chip>.ipp from the header
#   cppcoreguidelines-avoid-const-.. CRTP drivers hold a reference to their port
#   cppcoreguidelines-avoid-do-while do { } while (0) is the macro idiom
#   *-magic-numbers                  register addresses, masks and datasheet constants
#   cppcoreguidelines-pro-bounds-*   byte-buffer and register-table access in bus frames
#   cppcoreguidelines-pro-type-union register frame unions
#   cppcoreguidelines-pro-type-vararg the optional Log hook is printf-shaped
#   cppcoreguidelines-special-member  the rule-of-five is written out where it matters
#   modernize-use-trailing-return    not the Kokeb Labs style
#   portability-avoid-pragma-once    every header uses #pragma once
#   readability-function-cognitive  register sequences are long but flat
#   readability-identifier-length    i, n, T and reg are fine
#   readability-redundant-inline-.. `inline constexpr` is kept for clarity
#   readability-uppercase-literal-.. 0xFFu and 1.0f are both accepted

WarningsAsErrors: ''
HeaderFilterRegex: '.*/(inc|include|src|lib|handlers)/.*'
ExcludeHeaderFilterRegex: '.*/(build[^/]*|_deps|third_party|managed_components|external)/.*'
FormatStyle: file

CheckOptions:
  - { key: readability-implicit-bool-conversion.AllowPointerConditions, value: true }
  # Types: PascalCase. Chip classes keep the part number (PCA9685, TMC9660).
  - { key: readability-identifier-naming.NamespaceCase,                 value: lower_case }
  - { key: readability-identifier-naming.ClassCase,                     value: CamelCase }
  - { key: readability-identifier-naming.StructCase,                    value: CamelCase }
  - { key: readability-identifier-naming.UnionCase,                     value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,                      value: CamelCase }
  - { key: readability-identifier-naming.TypeAliasCase,                 value: CamelCase }
  - { key: readability-identifier-naming.TypedefCase,                   value: CamelCase }
  - { key: readability-identifier-naming.ConceptCase,                   value: CamelCase }
  - { key: readability-identifier-naming.TemplateParameterCase,         value: CamelCase }
  - { key: readability-identifier-naming.ValueTemplateParameterCase,    value: CamelCase }
  # kb::interfaces keeps its C-style kb_*_t types (kb_spi_err_t, kb_u8_t).
  - { key: readability-identifier-naming.TypeAliasIgnoredRegexp,        value: '^kb_[a-z0-9_]+_t$' }
  - { key: readability-identifier-naming.TypedefIgnoredRegexp,          value: '^kb_[a-z0-9_]+_t$' }
  # Enumerators: PascalCase; UPPER_CASE allowed for datasheet names and GpioSignal::ACTIVE.
  - { key: readability-identifier-naming.EnumConstantCase,              value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantIgnoredRegexp,     value: '^[A-Z][A-Z0-9_]*$' }
  # Functions and methods: PascalCase. Private helpers: camelBack.
  - { key: readability-identifier-naming.FunctionCase,                  value: CamelCase }
  - { key: readability-identifier-naming.MethodCase,                    value: CamelCase }
  - { key: readability-identifier-naming.PrivateMethodCase,             value: camelBack }
  # Allowed lower-case functions: kb::rtos's os_* and the kb_* C API, host test cases (test_*),
  # and the vocabulary-type members ok(), begin(), end(), size(), data(), empty().
  - { key: readability-identifier-naming.FunctionIgnoredRegexp,         value: '^((os|kb)_[a-z0-9_]+|test_[a-z0-9_]+)$' }
  - { key: readability-identifier-naming.MethodIgnoredRegexp,           value: '^(ok|begin|end|size|data|empty)$' }
  # Variables, parameters and public data members: snake_case.
  - { key: readability-identifier-naming.ParameterCase,                 value: lower_case }
  - { key: readability-identifier-naming.VariableCase,                  value: lower_case }
  - { key: readability-identifier-naming.MemberCase,                    value: lower_case }
  # Private and protected data members: snake_case_ with a trailing underscore.
  - { key: readability-identifier-naming.PrivateMemberCase,             value: lower_case }
  - { key: readability-identifier-naming.PrivateMemberSuffix,           value: '_' }
  - { key: readability-identifier-naming.ProtectedMemberCase,           value: lower_case }
  - { key: readability-identifier-naming.ProtectedMemberSuffix,         value: '_' }
  # Constants: kPascalCase. UPPER_CASE allowed for datasheet register and bit names.
  - { key: readability-identifier-naming.ConstexprVariableCase,         value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix,       value: k }
  - { key: readability-identifier-naming.ConstexprVariableIgnoredRegexp, value: '^[A-Z][A-Z0-9_]*$' }
  - { key: readability-identifier-naming.GlobalConstantCase,            value: CamelCase }
  - { key: readability-identifier-naming.GlobalConstantPrefix,          value: k }
  - { key: readability-identifier-naming.GlobalConstantIgnoredRegexp,   value: '^[A-Z][A-Z0-9_]*$' }
  - { key: readability-identifier-naming.StaticConstantCase,            value: CamelCase }
  - { key: readability-identifier-naming.StaticConstantPrefix,          value: k }
  - { key: readability-identifier-naming.StaticConstantIgnoredRegexp,   value: '^[A-Z][A-Z0-9_]*$' }
  - { key: readability-identifier-naming.ClassConstantCase,             value: CamelCase }
  - { key: readability-identifier-naming.ClassConstantPrefix,           value: k }
  - { key: readability-identifier-naming.ClassConstantIgnoredRegexp,    value: '^[A-Z][A-Z0-9_]*$' }
  # Macros: UPPER_CASE, prefixed with the chip in drivers (PCA9685_...) or KB_ in kb-core; CONFIG_... from Kconfig.
  - { key: readability-identifier-naming.MacroDefinitionCase,           value: UPPER_CASE }
